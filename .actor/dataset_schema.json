{
    "actorSpecification": 1,
    "fields": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "additionalProperties": true,
        "properties": {
            "date": {
                "type": "string",
                "description": "Weekly report date (DD/MM/YY)"
            },
            "iso_date": {
                "type": "string",
                "description": "ISO 8601 formatted date (YYYY-MM-DD)"
            },
            "asset": {
                "type": "string",
                "description": "Asset ticker (e.g. GOLD, BTC, EUR, S&P 500)"
            },
            "category": {
                "type": "string",
                "description": "Market sector: forex, crypto, metals, index, other"
            },
            "contract_code": {
                "type": "string",
                "description": "Official CFTC Contract Market Code"
            },
            "long_positions": {
                "type": "integer",
                "description": "Non-commercial (speculative/institutional) long positions"
            },
            "short_positions": {
                "type": "integer",
                "description": "Non-commercial short positions"
            },
            "change_long": {
                "type": "integer",
                "description": "Weekly change in non-commercial long positions"
            },
            "change_short": {
                "type": "integer",
                "description": "Weekly change in non-commercial short positions"
            },
            "net_position": {
                "type": "integer",
                "description": "Net institutional position (Long - Short)"
            },
            "report_id": {
                "type": "string",
                "description": "CFTC historical report identifier"
            },
            "latest_date": {
                "type": "string",
                "description": "Latest weekly report date when aggregated by asset"
            },
            "total_reports": {
                "type": "integer",
                "description": "Total number of weekly reports when aggregated by asset"
            },
            "history": {
                "type": "array",
                "description": "Historical weekly COT records when aggregated by asset",
                "items": {
                    "type": "object",
                    "additionalProperties": true
                }
            }
        },
        "required": []
    },
    "views": {
        "overview": {
            "title": "COT Overview Table",
            "transformation": {
                "fields": [
                    "date",
                    "asset",
                    "category",
                    "net_position",
                    "change_long",
                    "change_short",
                    "long_positions",
                    "short_positions"
                ]
            },
            "display": {
                "component": "table"
            }
        }
    }
}
